---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import DemosSection from '../components/DemosSection.astro';
import { siteConfig } from '../data/siteConfig';

const navigation = [
  { label: 'Colaboración', href: '#modalidades' },
  { label: 'Soluciones', href: '#resolver' },
  { label: 'Demos', href: '#demos' },
  { label: 'Preguntas', href: '#preguntas' },
];
const audiences = ['Gráficas', 'Community managers', 'Diseño y branding', 'Agencias pequeñas', 'Fotografía y producción', 'Consultoría y marketing'];
const areas = [
  { name: 'Sitios web', description: 'Una presencia propia para presentar un negocio, ordenar su propuesta o recibir consultas. Landings, webs de negocios, portfolios, institucionales y experiencias personalizadas.' },
  { name: 'Automatizaciones', description: 'Menos tareas repetidas y menos información copiada a mano. Formularios, organización de consultas, seguimiento y flujos entre herramientas, con asistencia de IA cuando aporte valor.' },
  { name: 'Sistemas', description: 'Herramientas para trabajar mejor puertas adentro: paneles, gestión y soluciones a medida para un proceso que hoy queda repartido entre planillas y mensajes.' },
  { name: 'Integraciones', description: 'Conectar lo que el negocio ya usa: Google Workspace, correo, bases de datos y herramientas externas mediante APIs o webhooks. También WhatsApp cuando la integración disponible lo permita.' },
];
const steps = [
  ['Aparece una necesidad', 'Un cliente te pide algo técnico que queda fuera de tu servicio.'],
  ['Me contás el problema', 'Con el contexto que tengas alcanza para empezar.'],
  ['Buscamos una solución', 'Revisamos qué tiene sentido hacer y qué necesitamos comprobar.'],
  ['Acordamos cómo trabajar', 'Definimos alcance, presupuesto, tiempos y quién habla con el cliente.'],
  ['Desarrollo y entrega', 'Resuelvo la parte técnica y coordinamos la revisión y la entrega.'],
];
const faqs = [
  ['¿Tengo que saber qué solución necesita mi cliente?', 'No. Con entender el problema alcanza para empezar. Podemos revisar juntos el proceso actual y las opciones.'],
  ['¿Podemos trabajar bajo mi marca?', 'Sí. Según el proyecto podemos coordinar una modalidad white label: vos mantenés la relación comercial y yo desarrollo la parte técnica. Acordamos la comunicación y la entrega antes de empezar.'],
  ['¿Sólo hacés páginas web?', 'También desarrollo automatizaciones, integraciones y sistemas. La herramienta depende del problema; no hace falta elegirla de antemano.'],
  ['¿Y si todavía no sabemos si el proyecto es viable?', 'Lo analizamos antes de comprometer alcance o presupuesto. Si hay una parte incierta, primero propongo una comprobación acotada.'],
  ['¿Trabajás sólo en Buenos Aires?', 'Estoy en Buenos Aires y podemos trabajar de forma remota, coordinando horarios y un canal de comunicación.'],
];
---

<Layout
  title="Colaboraciones | flitzfa — Web, automatizaciones y sistemas"
  description="Fabricio Enriquez, flitzfa: apoyo técnico para agencias, diseñadores y community managers. Webs, automatizaciones, integraciones y sistemas para tus clientes."
>
  <Navbar items={navigation} />
  <main id="contenido-principal" tabindex="-1" class="partners-page">
    <section class="partner-wrap partner-hero" aria-labelledby="partner-title">
      <p class="partner-kicker">Colaboraciones</p>
      <h1 id="partner-title">Tu vínculo con el cliente.<br /><span>Mi apoyo en la parte técnica.</span></h1>
      <div class="hero-bottom">
        <div>
          <p class="partner-lead">Si tus clientes necesitan algo técnico que vos no ofrecés, podemos trabajar juntos.</p>
          <p class="partner-copy">Soy Fabricio, de flitzfa. Desarrollo webs, automatizaciones, integraciones y sistemas para complementar el trabajo de profesionales y equipos que ya acompañan a negocios.</p>
          <div class="partner-actions">
            <a class="partner-button" href="#contacto">Hablemos</a>
            <a class="partner-text-link" href="#resolver">Ver qué puedo resolver <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <aside class="hero-note" aria-label="La idea de la colaboración">
          <p>Una necesidad nueva no tiene por qué quedar afuera de la conversación.</p>
          <span>Vos aportás el contexto del cliente. Yo, una forma de resolverlo.</span>
        </aside>
      </div>
    </section>

    <section class="partner-wrap partner-section audience" aria-labelledby="audience-title">
      <div>
        <h2 id="audience-title">Si ya trabajás con negocios,<br /><span>podemos complementarnos.</span></h2>
        <p class="partner-copy">A veces aparece una necesidad técnica que queda fuera de lo que ofrecés. Podemos verla juntos, sin que tengas que sumar un área de desarrollo a tu trabajo.</p>
      </div>
      <ul class="audience-list">{audiences.map((audience) => <li>{audience}</li>)}</ul>
    </section>

    <section id="modalidades" class="partner-wrap partner-section" aria-labelledby="modes-title">
      <div class="section-intro">
        <h2 id="modes-title">Dos formas de trabajar juntos.</h2>
        <p class="partner-copy">Elegimos la modalidad según el proyecto y cómo preferís acompañar a tu cliente.</p>
      </div>
      <div class="collaboration-modes">
        <article>
          <h3>Me presentás al cliente.</h3>
          <p class="mode-label">Derivación</p>
          <p>Converso con el cliente, defino el alcance, preparo el presupuesto y me encargo del desarrollo y la entrega.</p>
          <p>Cuando corresponda, podemos acordar una comisión por la derivación. Lo conversamos antes de avanzar, con claridad para todos.</p>
        </article>
        <article>
          <h3>Trabajo detrás de tu marca.</h3>
          <p class="mode-label">White label</p>
          <p>Vos mantenés la relación comercial. Yo resuelvo la parte técnica y trabajo coordinado con vos.</p>
          <p>La entrega puede hacerse bajo tu marca, según lo que acordemos. Definimos quién comunica, quién revisa y cómo acompañamos al cliente.</p>
        </article>
      </div>
    </section>

    <section id="resolver" class="partner-wrap partner-section" aria-labelledby="areas-title">
      <div class="section-intro">
        <h2 id="areas-title">Primero el problema.<br /><span>Después, la herramienta.</span></h2>
        <p class="partner-copy">Puede ser una web que falta, un proceso manual que se repite o herramientas que no se hablan entre sí.</p>
      </div>
      <div class="areas-list">{areas.map((area) => (
        <article><h3>{area.name}</h3><p>{area.description}</p></article>
      ))}</div>
    </section>

    <section class="partner-wrap demos-block" aria-label="Demos propias de flitzfa">
      <DemosSection headingLevel={2} ctaLabel="Probar demo" title="Ejemplos que podés probar y mostrar." description="Estas son demos propias con negocios ficticios. Sirven para conversar sobre una necesidad y pueden adaptarse a distintos rubros; no son trabajos realizados para esos negocios." />
      <div class="other-work">
        <p>También desarrollo automatizaciones propias y soluciones para organizar trabajo. Si querés conocer mi enfoque visual, podés recorrer los proyectos web del portfolio.</p>
        <a class="partner-text-link" href="/#proyectos">Ver proyectos web <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="partner-wrap partner-section" aria-labelledby="process-title">
      <div class="section-intro"><h2 id="process-title">Empezamos con una conversación.</h2><p class="partner-copy">Sin tener que llegar con un brief técnico resuelto.</p></div>
      <ol class="partner-steps">{steps.map(([title, description]) => <li><h3>{title}</h3><p>{description}</p></li>)}</ol>
    </section>

    <section class="philosophy" aria-labelledby="philosophy-title">
      <div class="partner-wrap philosophy-inner">
        <h2 id="philosophy-title">La idea es complementar<br /><span>lo que ya hacés.</span></h2>
        <div><p>No busco reemplazar tu trabajo ni desplazar tu relación con el cliente. Acordamos cómo participar y mantenemos una comunicación clara.</p><p>Si una solución más simple alcanza, la propongo. Si algo no hace falta o necesita comprobarse, lo hablamos antes de venderlo.</p></div>
      </div>
    </section>

    <section id="preguntas" class="partner-wrap partner-section faq-section" aria-labelledby="faq-title">
      <h2 id="faq-title">Antes de hablar.</h2>
      <div class="partner-faq">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </section>

    <section id="contacto" class="partner-wrap partner-contact" aria-labelledby="partner-contact-title">
      <p class="partner-kicker">Hablemos</p>
      <h2 id="partner-contact-title">Cuando aparezca esa necesidad,<br /><span>tenés con quién hablar.</span></h2>
      <p class="partner-lead">Si algo queda fuera de lo que hacés, escribime. Contame el contexto y vemos cómo podemos trabajar juntos.</p>
      <div class="partner-actions">
        <a class="partner-button" href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Hablemos por WhatsApp (abre en otra pestaña)">Hablemos por WhatsApp <span aria-hidden="true">↗</span></a>
        <a class="partner-text-link email-link" href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
      </div>
      <p class="contact-note">Conversación directa con Fabricio. Buenos Aires · Trabajo remoto.</p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .partners-page { --partner-measure: 76ch; }
  .partner-wrap { max-width: 1280px; margin-inline: auto; padding-inline: 48px; }
  .partners-page :is(section[id], div[id]) { scroll-margin-top: 112px; }
  .partner-hero { padding-block: 64px 80px; }
  .partner-kicker { color: var(--color-primary-text); font-size: .875rem; font-weight: 600; margin-bottom: 24px; }
  h1 { font-size: clamp(2.6rem, 5.1vw, 4.6rem); line-height: 1.08; letter-spacing: -.045em; font-weight: 800; max-width: 1100px; }
  h1 span, h2 span { font-family: var(--font-editorial); font-weight: 400; font-style: italic; color: var(--color-dark); }
  h2 { font-size: clamp(2rem, 3vw, 3rem); line-height: 1.14; letter-spacing: -.035em; font-weight: 800; }
  h3 { font-size: 1.5rem; line-height: 1.25; letter-spacing: -.025em; font-weight: 700; }
  .partner-lead { font-size: 1.25rem; line-height: 1.65; max-width: 54ch; }
  .partner-copy { color: var(--color-text-muted); font-size: 1rem; line-height: 1.8; max-width: var(--partner-measure); }
  .hero-bottom { display: grid; grid-template-columns: 1.4fr .8fr; gap: 80px; margin-top: 40px; align-items: end; }
  .hero-bottom .partner-copy { margin-top: 18px; }
  .partner-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px; margin-top: 28px; }
  .partner-button { display: inline-flex; gap: 12px; align-items: center; justify-content: center; min-height: 48px; padding: 14px 26px; border-radius: 999px; font-size: .875rem; font-weight: 600; color: var(--color-bg); background: var(--color-dark); }
  .partner-button:hover { background: var(--color-text-main); }
  .partner-text-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; font-size: .875rem; font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-primary); text-underline-offset: 6px; }
  .hero-note { padding: 8px 0 8px 28px; border-left: 2px solid var(--color-primary); }
  .hero-note p { font-family: var(--font-editorial); font-style: italic; color: var(--color-dark); font-size: 1.65rem; line-height: 1.35; }
  .hero-note span { display: block; color: var(--color-text-muted); font-size: .875rem; line-height: 1.7; margin-top: 16px; }
  .partner-section { padding-block: 64px; }
  .audience { display: grid; grid-template-columns: 1.2fr 1fr; gap: 64px; border-top: 1px solid var(--color-border); }
  .audience .partner-copy { margin-top: 20px; }
  .audience-list { display: flex; flex-wrap: wrap; gap: 0 24px; align-content: start; list-style: none; }
  .audience-list li { padding-block: 14px; border-bottom: 1px solid var(--color-border); font-size: .95rem; }
  .section-intro { display: grid; grid-template-columns: 1.2fr 1fr; gap: 64px; align-items: end; margin-bottom: 32px; }
  .collaboration-modes { display: grid; grid-template-columns: 1fr 1fr; border-block: 1px solid var(--color-border); }
  .collaboration-modes article { padding-block: 32px; }
  .collaboration-modes article:first-child { padding-right: 48px; border-right: 1px solid var(--color-border); }
  .collaboration-modes article:last-child { padding-left: 48px; }
  .collaboration-modes p:not(.mode-label) { font-size: 1rem; color: var(--color-text-muted); line-height: 1.8; margin-top: 16px; max-width: 60ch; }
  .mode-label { font-size: .875rem; color: var(--color-primary-text); font-weight: 600; margin-top: 12px; }
  .areas-list { border-top: 1px solid var(--color-border); }
  .areas-list article { display: grid; grid-template-columns: 1fr 1.7fr; gap: 48px; padding-block: 28px; border-bottom: 1px solid var(--color-border); }
  .areas-list p, .other-work p, .partner-steps p { color: var(--color-text-muted); line-height: 1.8; }
  .demos-block { padding-bottom: 32px; }
  .demos-block :global(#demos) { margin-top: 24px; }
  .other-work { display: flex; gap: 36px; align-items: center; justify-content: space-between; padding-block: 28px; }
  .other-work p { max-width: 74ch; font-size: .95rem; }
  .other-work a { flex-shrink: 0; }
  .partner-steps { counter-reset: step; display: grid; grid-template-columns: repeat(5, 1fr); gap: 28px; list-style: none; }
  .partner-steps li { counter-increment: step; border-top: 1px solid var(--color-border); padding-top: 20px; }
  .partner-steps li::before { content: '0' counter(step); display: block; color: var(--color-primary-text); font-family: var(--font-mono); font-size: .75rem; margin-bottom: 14px; }
  .partner-steps h3 { font-size: 1rem; line-height: 1.5; }
  .partner-steps p { font-size: .875rem; margin-top: 10px; }
  .philosophy { margin-top: 24px; padding-block: 64px; background: var(--color-surface); border-block: 1px solid var(--color-border); }
  .philosophy-inner, .faq-section { display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; }
  .philosophy p { color: var(--color-text-muted); line-height: 1.8; }
  .philosophy p + p { margin-top: 18px; }
  .partner-faq details { border-bottom: 1px solid var(--color-border); }
  .partner-faq details:first-child { border-top: 1px solid var(--color-border); }
  .partner-faq summary { cursor: pointer; padding: 22px 4px; font-weight: 600; font-size: 1rem; line-height: 1.65; }
  .partner-faq summary::marker { color: var(--color-primary-text); }
  .partner-faq p { color: var(--color-text-muted); line-height: 1.8; padding: 0 4px 24px; }
  .partner-contact { padding-block: 40px 96px; }
  .partner-contact h2 { font-size: clamp(2.3rem, 4vw, 3.5rem); }
  .partner-contact .partner-lead { color: var(--color-text-muted); margin-top: 24px; }
  .contact-note { margin-top: 24px; font-size: .8rem; color: var(--color-text-muted); }
  .email-link { overflow-wrap: anywhere; }
  @media (max-width: 1100px) { .hero-bottom, .section-intro, .audience { gap: 40px; } .partner-steps { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 767px) {
    .partner-wrap { padding-inline: 24px; }
    .partner-hero { padding-block: 40px 48px; }
    .hero-bottom, .section-intro, .audience, .philosophy-inner, .faq-section { grid-template-columns: 1fr; gap: 28px; }
    .hero-bottom { margin-top: 28px; }
    .hero-note { margin-top: 12px; padding-left: 20px; }
    .hero-note p { font-size: 1.4rem; }
    .partner-lead { font-size: 1.1rem; }
    .partner-section { padding-block: 40px; }
    .collaboration-modes { grid-template-columns: 1fr; }
    .collaboration-modes article:first-child { padding-right: 0; border-right: 0; border-bottom: 1px solid var(--color-border); }
    .collaboration-modes article:last-child { padding-left: 0; }
    .areas-list article { grid-template-columns: 1fr; gap: 14px; }
    .other-work { flex-direction: column; align-items: start; gap: 12px; }
    .partner-steps { grid-template-columns: 1fr; gap: 20px; }
    .partner-steps li { display: grid; grid-template-columns: 28px 1fr; column-gap: 16px; }
    .partner-steps li::before { grid-row: span 2; padding-top: 5px; }
    .partner-steps p { margin-top: 4px; }
    .philosophy { padding-block: 40px; }
    .partner-contact { padding-block: 32px 64px; }
  }
</style>
