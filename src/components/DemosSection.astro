---
import type { ImageMetadata } from 'astro';
import { siteConfig } from '../data/siteConfig';
import PhoneFrame from './PhoneFrame.astro';
import turnosScreen from '../assets/screens/demo-turnos.webp';
import catalogoScreen from '../assets/screens/demo-catalogo.webp';
// Comentado mientras la demo está oculta: importarlo publica el archivo en el build aunque no se use.
// import distribuidoraScreen from '../assets/screens/demo-distribuidora.webp';
import gimnasioScreen from '../assets/screens/demo-gimnasio.webp';
import veterinariaScreen from '../assets/screens/demo-veterinaria.webp';

interface Props {
  headingLevel?: 2 | 3;
  ctaLabel?: string;
  title?: string;
  description?: string;
  showCta?: boolean;
}

const {
  headingLevel = 3,
  ctaLabel = 'Ver demo',
  title = 'Probá cómo podría funcionar en tu negocio.',
  description = 'Estos ejemplos los armé yo con negocios inventados. Entrá, tocá todo y fijate si algo así te serviría. Se pueden adaptar a otros rubros.',
  showCta = false,
} = Astro.props;

const Heading = headingLevel === 2 ? 'h2' : 'h3';
const ItemHeading = headingLevel === 2 ? 'h3' : 'h4';

type Demo = {
  title: string;
  name: string;
  description: string;
  features: string[];
  note?: string;
  url?: string;
  screen?: ImageMetadata;
  screenAlt?: string;
};

// TODO(Fabri): demo oculta por ahora. Para volver a mostrarla: pasá este flag a true, descomentá `distribuidoraScreen` (import y `screen`), devolvé su URL a la lista de
// tests/public-build.test.mjs, sacá el test 'hidden demo is not in the built pages' y volvé a listarla en docs/DEMOS_PUBLICAS.md.
const showDistribuidoraDemo = false;

const liveDemos: Demo[] = [
  {
    title: 'Sistema de turnos',
    name: 'Estudio Pausa',
    description: 'Tus clientes reservan solos y vos ves la agenda del día.',
    features: ['Reserva online y disponibilidad', 'Agenda, servicios y panel administrativo', 'Horarios y bloqueos'],
    note: 'Probá una reserva ficticia y explorá la vista del negocio.',
    url: 'https://turnos.flitzfa.com.ar/',
    screen: turnosScreen,
    screenAlt: 'Demo de turnos de Estudio Pausa en un celular: un selector entre vista cliente y vista del negocio, y la portada “Un momento para vos.” con el botón para buscar horario.',
  },
  {
    title: 'Catálogo + WhatsApp',
    name: 'Miga & Materia',
    description: 'El cliente arma el pedido en la web y te llega por WhatsApp, ya ordenado.',
    features: ['Catálogo y categorías', 'Variantes y carrito', 'Pedido ordenado por WhatsApp'],
    note: 'Armá un pedido y revisá el mensaje de ejemplo, sin enviarlo.',
    url: 'https://catalogo.flitzfa.com.ar/',
    screen: catalogoScreen,
    screenAlt: 'Demo de catálogo de Miga & Materia en un celular: la portada “Lo cotidiano merece cosas lindas.”, el carrito arriba y una taza azul destacada.',
  },
  {
    title: 'Catálogo mayorista',
    name: 'Distribuidora Ruta 3',
    description: 'Tu lista de precios online. Cuando hay aumento, lo cargás una vez y se actualiza todo.',
    features: ['Precios por caja y ofertas', 'Pedido armado por WhatsApp', 'Panel con aumento masivo de precios'],
    note: 'Armá un pedido y probá un aumento de precios en el panel.',
    url: 'https://distribuidora.flitzfa.com.ar/',
    // screen: distribuidoraScreen,
    screenAlt: 'Demo de Distribuidora Ruta 3 en un celular: buscador de productos, accesos a la lista completa y a ofertas, y los pasos para elegir, enviar y recibir el pedido.',
  },
];

const visibleLiveDemos = liveDemos.filter((demo) => showDistribuidoraDemo || demo.name !== 'Distribuidora Ruta 3');

const siteDemos: Demo[] = [
  {
    title: 'Web para gimnasio',
    name: 'Bloque Funcional',
    description: 'Las disciplinas y los horarios a la vista, y las consultas van directo a tu WhatsApp.',
    features: ['Disciplinas y grilla semanal', 'Ubicación y horarios', 'Consultas por WhatsApp'],
    note: 'Revisá la grilla y probá pedir una clase: ves el mensaje de ejemplo, sin enviarlo.',
    url: 'https://gimnasio.flitzfa.com.ar/',
    screen: gimnasioScreen,
    screenAlt: 'Demo de Bloque Funcional en un celular: el aviso de demo arriba, la portada “Entrenás en grupo, a tu ritmo.” sobre una sala de entrenamiento y el botón para probar una clase.',
  },
  {
    title: 'Web para veterinaria',
    name: 'Veterinaria Trébol',
    description: 'Los servicios ordenados, y pedir turno es mandar un WhatsApp.',
    features: ['Servicios ordenados', 'Aviso de abierto o cerrado según el horario', 'Turnos por WhatsApp'],
    note: 'Fijate si está abierta ahora y pedí un turno de ejemplo, sin enviarlo.',
    url: 'https://veterinaria.flitzfa.com.ar/',
    screen: veterinariaScreen,
    screenAlt: 'Demo de Veterinaria Trébol en un celular: el aviso de abierto o cerrado, la portada “Cuidamos a tu perro o tu gato como en casa.” y el botón para pedir turno por WhatsApp.',
  },
];
---

<div id="demos" class="scroll-mt-28 mt-20 sm:mt-24" aria-labelledby="demos-heading">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 mb-10 items-end">
    <div class="lg:col-span-6">
      <Heading id="demos-heading" class="type-heading text-[#141D16]">
        {title}
      </Heading>
    </div>
    <p class="lg:col-span-6 type-body text-[#515B53] max-w-[56ch]">
      {description}
    </p>
  </div>

  {[visibleLiveDemos, siteDemos].map((demos, group) => (
    <div class:list={['grid grid-cols-1 border-b border-[#D8DFD5]', group === 0 && 'border-t', demos.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
      {demos.map((demo, index) => (
        <article class:list={[
          'py-10 sm:py-12 flex flex-col',
          index > 0 && 'md:pl-8 lg:pl-12',
          index < demos.length - 1 && 'md:pr-8 lg:pr-12 border-b md:border-b-0 md:border-r border-[#D8DFD5]',
        ]}>
          {demo.screen && demo.screenAlt && (
            <PhoneFrame
              src={demo.screen}
              alt={demo.screenAlt}
              sizes="180px"
              class="w-[180px] mb-8"
            />
          )}
          <ItemHeading class="type-heading text-[#141D16]">{demo.title}</ItemHeading>
          <p class="mt-2 type-sm text-[#375B3F] font-medium">
            {demo.name} · {demo.url ? 'Demo interactiva' : 'En preparación'}
          </p>
          <p class="mt-4 type-body text-[#515B53] max-w-[46ch]">{demo.description}</p>
          <ul class="mt-5 space-y-2 type-body text-[#141D16] list-disc pl-5 marker:text-[#4F7A59]">
            {demo.features.map((feature) => <li>{feature}</li>)}
          </ul>
          {demo.note && <p class="mt-5 mb-7 type-sm text-[#515B53] max-w-[48ch]">{demo.note}</p>}
          {demo.url && (
            <a
              href={demo.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${ctaLabel} de ${demo.title} (abre en otra pestaña)`}
              class="mt-auto self-start inline-flex min-h-11 items-center gap-2 px-6 py-3 rounded-full bg-[#1A2E20] text-[#F5F6F0] type-sm font-semibold hover:bg-[#141D16]"
            >
              <span>{ctaLabel}</span>
              <span class="text-[#9BB89E]" aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
    </div>
  ))}

  {showCta && (
    <p class="mt-10 type-body text-[#141D16]">
      ¿Te sirve algo así para tu negocio?{' '}
      <a
        href={siteConfig.contact.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Escribime por WhatsApp (abre en otra pestaña)"
        class="inline-flex min-h-11 items-center font-semibold underline decoration-[#4F7A59] decoration-2 underline-offset-4 hover:text-[#375B3F]"
      >Escribime ↗</a>
    </p>
  )}
</div>
