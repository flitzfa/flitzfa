---
import { siteConfig } from '../data/siteConfig';
import PhoneFrame from './PhoneFrame.astro';
import turnosScreen from '../assets/screens/demo-turnos.webp';
import catalogoScreen from '../assets/screens/demo-catalogo.webp';
import distribuidoraScreen from '../assets/screens/demo-distribuidora.webp';

interface Props { headingLevel?: 2 | 3; ctaLabel?: string; title?: string; description?: string; showCta?: boolean; }
const { headingLevel = 3, ctaLabel = 'Ver demo', title = 'Probá cómo podría funcionar en tu negocio.', description = 'Estos ejemplos los armé yo con negocios inventados. Entrá, tocá todo y fijate si algo así te serviría. Se pueden adaptar a otros rubros.', showCta = false } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const ItemHeading = headingLevel === 2 ? 'h3' : 'h4';
const demos = [
  {
    title: 'Sistema de turnos',
    name: 'Estudio Pausa',
    description: 'Tus clientes reservan solos y vos ves la agenda del día.',
    features: ['Reserva online y disponibilidad', 'Agenda, servicios y panel administrativo', 'Horarios y bloqueos'],
    note: 'Probá una reserva ficticia y explorá la vista del negocio.',
    url: 'https://turnos.flitzfa.com.ar/',
    screen: turnosScreen,
    screenAlt: 'Demo de turnos de Estudio Pausa en un celular: un selector entre vista cliente y vista del negocio, y la portada “Un momento para vos.” con el botón para buscar horario.',
  },
  {
    title: 'Catálogo + WhatsApp',
    name: 'Miga & Materia',
    description: 'El cliente arma el pedido en la web y te llega por WhatsApp, ya ordenado.',
    features: ['Catálogo y categorías', 'Variantes y carrito', 'Pedido ordenado por WhatsApp'],
    note: 'Armá un pedido y revisá el mensaje de ejemplo, sin enviarlo.',
    url: 'https://catalogo.flitzfa.com.ar/',
    screen: catalogoScreen,
    screenAlt: 'Demo de catálogo de Miga & Materia en un celular: la portada “Lo cotidiano merece cosas lindas.”, el carrito arriba y una taza azul destacada.',
  },
  {
    title: 'Catálogo mayorista',
    name: 'Distribuidora Ruta 3',
    description: 'Tu lista de precios online. Cuando hay aumento, lo cargás una vez y se actualiza todo.',
    features: ['Precios por caja y ofertas', 'Pedido armado por WhatsApp', 'Panel con aumento masivo de precios'],
    note: 'Armá un pedido y probá un aumento de precios en el panel.',
    url: 'https://distribuidora.flitzfa.com.ar/',
    screen: distribuidoraScreen,
    screenAlt: 'Demo de Distribuidora Ruta 3 en un celular: buscador de productos, accesos a la lista completa y a ofertas, y los pasos para elegir, enviar y recibir el pedido.',
  },
];
---

<div id="demos" class="scroll-mt-28 mt-16 sm:mt-20" aria-labelledby="demos-heading">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-12 mb-8">
    <div class="lg:col-span-6">
      <p class="text-sm font-semibold text-primary-text mb-3">Demos propias</p>
      <Heading id="demos-heading" class="text-3xl sm:text-4xl font-extrabold text-[#182019] tracking-tight leading-tight">
        {title}
      </Heading>
    </div>
    <p class="lg:col-span-6 lg:self-end text-base sm:text-lg text-[#697069] leading-relaxed max-w-2xl">
      {description}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 border-y border-[#D9DED4]">
    {demos.map((demo, index) => (
      <article class:list={[
        'py-8 sm:py-10 flex flex-col',
        index > 0 && 'md:pl-6 lg:pl-10',
        index < demos.length - 1 && 'md:pr-6 lg:pr-10 border-b md:border-b-0 md:border-r border-[#D9DED4]',
      ]}>
        <PhoneFrame
          src={demo.screen}
          alt={demo.screenAlt}
          sizes="180px"
          class="w-[180px] mb-8"
        />
        <p class="text-sm text-[#697069] mb-2">{demo.name} · Demo interactiva</p>
        <ItemHeading class="text-2xl sm:text-3xl font-bold tracking-tight text-[#182019]">{demo.title}</ItemHeading>
        <p class="mt-3 text-base text-[#697069] leading-relaxed max-w-md">{demo.description}</p>
        <ul class="mt-5 space-y-2 text-sm sm:text-base text-[#263B2B] list-disc pl-5 marker:text-[#6F8F72]">
          {demo.features.map((feature) => <li>{feature}</li>)}
        </ul>
        <p class="mt-5 mb-6 text-sm text-[#697069] leading-relaxed">{demo.note}</p>
        <a
          href={demo.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${ctaLabel} de ${demo.title} (abre en otra pestaña)`}
          class="mt-auto self-start inline-flex min-h-11 items-center px-6 py-3 rounded-full bg-[#263B2B] text-[#F4F5ED] text-sm font-semibold hover:bg-[#182019]"
        >{ctaLabel}</a>
      </article>
    ))}
  </div>

  {showCta && (
    <p class="mt-8 text-base sm:text-lg text-[#182019]">
      ¿Te sirve algo así para tu negocio?{' '}
      <a
        href={siteConfig.contact.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Escribime por WhatsApp (abre en otra pestaña)"
        class="inline-flex min-h-11 items-center font-semibold underline decoration-[#6F8F72] decoration-2 underline-offset-4 hover:text-[#263B2B]"
      >Escribime ↗</a>
    </p>
  )}
</div>
