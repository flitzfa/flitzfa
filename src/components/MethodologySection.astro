---
import { methodologySteps } from '../data/services';
---

<section class="py-24 sm:py-32 relative bg-[#263B2B] text-[#F4F5ED] rounded-3xl sm:rounded-[40px] my-12 mx-4 sm:mx-8 lg:mx-12 overflow-hidden">
  
  <!-- Subtle Abstract Geometric Background Texture -->
  <div
    class="pointer-events-none absolute -top-40 -right-40 w-96 h-96 rounded-full border border-white/5"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-20 -left-20 w-80 h-80 rounded-full border border-[#6F8F72]/10"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 relative z-10">
    
    <!-- Section Headline -->
    <div class="max-w-3xl mb-16 sm:mb-24">
      <span class="text-xs font-mono tracking-widest text-[#A8BFA3] uppercase block mb-4">
        03 — PROCESO DE TRABAJO
      </span>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.12]">
        No empiezo por el código.<br />
        <span class="font-serif italic font-normal text-[#DCE7D7]">
          Empiezo por la idea<span class="text-[#6F8F72] not-italic">.</span>
        </span>
      </h2>
      <p class="mt-6 text-sm sm:text-base text-[#DCE7D7]/80 leading-relaxed max-w-xl">
        Programar es la herramienta final, no el punto de partida. Antes de abrir el editor de código, el proyecto necesita tener claro qué es, a quién le habla y qué experiencia busca generar.
      </p>
    </div>

    <!-- 4-Step Editorial Flow (Not generic cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 relative">
      {methodologySteps.map((step, idx) => (
        <div class="flex flex-col justify-between border-t border-white/15 pt-6 relative group">
          <div>
            <!-- Step Number -->
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-2xl font-bold text-[#A8BFA3]">
                {step.number}
              </span>
              <span class="text-xs font-mono text-white/40 group-hover:text-[#A8BFA3] transition-colors">
                Paso 0{idx + 1}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-1">
              {step.title}
            </h3>

            <!-- Subtitle -->
            <p class="text-xs font-serif italic text-[#A8BFA3] mb-3">
              {step.subtitle}
            </p>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-white/70 leading-relaxed">
              {step.description}
            </p>
          </div>

          <!-- Bottom Micro Accent -->
          <div class="mt-6 pt-4 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#6F8F72] group-hover:scale-150 transition-transform"></span>
            <span class="text-[10px] font-mono tracking-wider uppercase text-white/40">Fase clave</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
