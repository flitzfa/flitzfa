---
import { siteConfig } from '../data/siteConfig';
---

<footer class="py-10 sm:py-12 bg-[#F5F6F0] border-t border-[#D8DFD5] text-[#515B53]">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 flex flex-col xl:flex-row items-center justify-between gap-6">
    <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
      <a
        href={Astro.url.pathname === '/' ? '#inicio' : '/'}
        class="min-h-11 text-[22px] font-bold tracking-[-0.03em] text-[#141D16] inline-flex items-center"
      >
        <span>flitzfa</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#4F7A59] ml-0.5" aria-hidden="true"></span>
      </a>
      <span class="hidden sm:inline text-[#D8DFD5]" aria-hidden="true">|</span>
      <span class="type-sm">{siteConfig.brand.tagline}</span>
    </div>

    <div class="type-sm">
      <span>© 2026 flitzfa. Todos los derechos reservados.</span>
    </div>

    <div class="flex flex-wrap justify-center items-center gap-x-6 gap-y-1 type-sm font-medium">
      <a
        href="/partners"
        aria-current={Astro.url.pathname.replace(/\/$/, '') === '/partners' ? 'page' : undefined}
        class="inline-flex min-h-11 items-center hover:text-[#141D16]"
      >
        Colaboraciones
      </a>
      <a
        href={siteConfig.contact.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram de flitzfa (abre en una nueva pestaña)"
        class="inline-flex min-h-11 items-center hover:text-[#141D16]"
      >
        Instagram
      </a>
      <a
        href={siteConfig.contact.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub de flitzfa (abre en una nueva pestaña)"
        class="inline-flex min-h-11 items-center hover:text-[#141D16]"
      >
        GitHub
      </a>
      <a
        href={siteConfig.contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn de Fabricio Enriquez (abre en una nueva pestaña)"
        class="inline-flex min-h-11 items-center hover:text-[#141D16]"
      >
        LinkedIn
      </a>
      <a
        href={siteConfig.contact.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="WhatsApp de flitzfa (abre en una nueva pestaña)"
        class="inline-flex min-h-11 items-center hover:text-[#141D16]"
      >
        WhatsApp
      </a>
    </div>
  </div>
</footer>
