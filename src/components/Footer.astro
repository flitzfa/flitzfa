---
import { siteConfig } from '../data/siteConfig';
---

<footer class="py-12 bg-[#F4F5ED] border-t border-[#D9DED4]/80 text-[#697069]">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-6">
    
    <!-- Brand & Role -->
    <div class="flex items-center gap-4">
      <a href="#inicio" class="text-xl font-bold tracking-tight text-[#182019] inline-flex items-baseline">
        <span>flitzfa</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#6F8F72] ml-0.5"></span>
      </a>
      <span class="text-xs text-[#D9DED4]">|</span>
      <span class="text-xs font-mono">{siteConfig.brand.tagline}</span>
    </div>

    <!-- Copyright -->
    <div class="text-xs font-mono">
      <span>© 2026 flitzfa. Todos los derechos reservados.</span>
    </div>

    <!-- Direct Links -->
    <div class="flex items-center gap-5 text-xs font-medium">
      <a
        href={siteConfig.contact.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[#182019] transition-colors"
      >
        Instagram
      </a>
      <a
        href={siteConfig.contact.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[#182019] transition-colors"
      >
        GitHub
      </a>
      <a
        href={siteConfig.contact.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[#182019] transition-colors"
      >
        WhatsApp
      </a>
    </div>

  </div>
</footer>
