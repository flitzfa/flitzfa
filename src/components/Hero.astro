---
import { Image } from 'astro:assets';
import mariaBeachScreen from '../assets/screens/maria-beach.webp';
import turnosScreen from '../assets/screens/demo-turnos.webp';
import catalogoScreen from '../assets/screens/demo-catalogo.webp';

const stageItems = [
  {
    id: 'parador',
    tabLabel: 'Web de negocio',
    title: 'María Beach',
    subtitle: 'Parador de playa en Ituzaingó, Corrientes',
    summary: 'Propuesta, agenda, cómo llegar y consultas por WhatsApp en un sitio pensado para el celular.',
    url: 'https://www.paradormariabeach.com.ar/',
    cta: 'Visitar sitio',
    screen: mariaBeachScreen,
    alt: 'Portada móvil de María Beach sobre el atardecer en el río.',
    tint: '#244033',
  },
  {
    id: 'turnos',
    tabLabel: 'Sistema de turnos',
    title: 'Estudio Pausa',
    subtitle: 'Demo interactiva de reservas online',
    summary: 'Tus clientes eligen día y horario solos, y vos administrás la agenda desde un panel claro.',
    url: 'https://turnos.flitzfa.com.ar/',
    cta: 'Probar demo',
    screen: turnosScreen,
    alt: 'Demo móvil del sistema de turnos de Estudio Pausa.',
    tint: '#273E34',
  },
  {
    id: 'catalogo',
    tabLabel: 'Catálogo y pedidos',
    title: 'Miga & Materia',
    subtitle: 'Demo interactiva con pedido a WhatsApp',
    summary: 'El cliente recorre productos, elige variantes y te envía el pedido armado por WhatsApp.',
    url: 'https://catalogo.flitzfa.com.ar/',
    cta: 'Probar demo',
    screen: catalogoScreen,
    alt: 'Demo móvil del catálogo de Miga & Materia.',
    tint: '#2A3F2F',
  },
];
---

<section
  id="inicio"
  class="relative w-full overflow-hidden bg-[#1A2E20] text-[#F5F6F0] pt-28 pb-16 sm:pt-36 sm:pb-24 lg:pt-40 lg:pb-28"
  aria-labelledby="hero-title"
  style="background-image: radial-gradient(ellipse 80% 55% at 50% 0%, rgba(79, 122, 89, 0.34), transparent 70%);"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <!-- Centered Monumental Headline & Concise Copy -->
    <div class="max-w-5xl mx-auto text-center">
      <h1
        id="hero-title"
        class="hero-rise font-serif font-medium text-[#F5F6F0] text-[clamp(2.85rem,7.2vw,6.25rem)] leading-[0.97] tracking-[-0.035em]"
        style="--d: 40ms"
      >
        Webs a medida para comercios y negocios<span class="text-[#8CC096]">.</span>
      </h1>

      <p
        class="hero-rise mt-7 sm:mt-8 mx-auto max-w-[46ch] type-body text-[#DCE8DC]/90"
        style="--d: 140ms"
      >
        Diseño tu sitio, catálogo o sistema de turnos desde cero y automatizo las tareas que hoy repetís a mano.
      </p>

      <div class="hero-rise mt-8 sm:mt-10 flex justify-center" style="--d: 220ms">
        <a
          href="#contacto"
          class="inline-flex min-h-12 items-center gap-2.5 px-8 py-3.5 rounded-full bg-[#F5F6F0] text-[#141D16] type-sm font-semibold hover:bg-[#DCE8DC] hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 shadow-sm"
        >
          <span>Contame qué necesitás</span>
          <span class="text-[#375B3F]" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <!-- Wide Interactive Live-Work Stage -->
    <div
      class="hero-rise mt-14 sm:mt-16 lg:mt-20 max-w-5xl mx-auto rounded-3xl bg-[#223A29]/90 border border-[#F5F6F0]/12 p-5 sm:p-8 lg:p-10 shadow-2xl"
      style="--d: 320ms"
    >
      <!-- Connected Segmented Switcher -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-[#F5F6F0]/12">
        <div
          role="tablist"
          aria-label="Ejemplos de trabajos y demos"
          class="inline-flex self-start rounded-full bg-[#142419] p-1 border border-[#F5F6F0]/10"
        >
          {stageItems.map((item, idx) => (
            <button
              type="button"
              role="tab"
              id={`hero-tab-${item.id}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`hero-panel-${item.id}`}
              data-stage-tab={item.id}
              class:list={[
                'hero-stage-tab px-4 py-2 rounded-full type-sm font-medium cursor-pointer',
                idx === 0
                  ? 'bg-[#F5F6F0] text-[#141D16]'
                  : 'text-[#DCE8DC]/80 hover:text-[#F5F6F0]',
              ]}
            >
              {item.tabLabel}
            </button>
          ))}
        </div>

        <a
          href="#proyectos"
          class="type-sm font-medium text-[#DCE8DC]/85 hover:text-[#F5F6F0] underline decoration-[#8CC096] underline-offset-4 self-start sm:self-auto"
        >
          Ver todo el portfolio ↓
        </a>
      </div>

      <!-- Stage Panels -->
      <div class="mt-6 sm:mt-8">
        {stageItems.map((item, idx) => (
          <div
            role="tabpanel"
            id={`hero-panel-${item.id}`}
            aria-labelledby={`hero-tab-${item.id}`}
            data-stage-panel={item.id}
            hidden={idx !== 0}
            class="hero-stage-panel grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center"
          >
            <div class="md:col-span-6 lg:col-span-7 space-y-4 text-left">
              <p class="type-sm text-[#9BB89E] font-medium">{item.subtitle}</p>
              <h2 class="type-heading text-[#F5F6F0]">{item.title}</h2>
              <p class="type-body text-[#DCE8DC]/85 max-w-[46ch]">{item.summary}</p>
              <div class="pt-2">
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${item.cta}: ${item.title} (abre en una nueva pestaña)`}
                  class="inline-flex min-h-11 items-center gap-2 type-sm font-semibold text-[#F5F6F0] underline decoration-[#8CC096] decoration-2 underline-offset-6 hover:text-[#DCE8DC]"
                >
                  <span>{item.cta}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>

            <div class="md:col-span-6 lg:col-span-5 flex justify-center md:justify-end">
              <div class="w-[200px] sm:w-[225px] rounded-[2rem] bg-[#0F1912] p-[7px] shadow-2xl ring-1 ring-white/15">
                <Image
                  src={item.screen}
                  alt={item.alt}
                  widths={[240, 390, 520]}
                  sizes="(min-width: 640px) 225px, 200px"
                  class="block w-full h-auto rounded-[1.55rem]"
                  loading={idx === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-stage-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-stage-panel]'));

  function activateTab(targetId: string) {
    tabs.forEach((tab) => {
      const isSelected = tab.dataset.stageTab === targetId;
      tab.setAttribute('aria-selected', String(isSelected));
      tab.classList.toggle('bg-[#F5F6F0]', isSelected);
      tab.classList.toggle('text-[#141D16]', isSelected);
      tab.classList.toggle('text-[#DCE8DC]/80', !isSelected);
      tab.classList.toggle('hover:text-[#F5F6F0]', !isSelected);
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.stagePanel !== targetId;
    });
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => {
      if (tab.dataset.stageTab) activateTab(tab.dataset.stageTab);
    });

    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const nextIndex = event.key === 'ArrowRight'
        ? (index + 1) % tabs.length
        : (index - 1 + tabs.length) % tabs.length;
      const nextTab = tabs[nextIndex];
      if (nextTab?.dataset.stageTab) {
        activateTab(nextTab.dataset.stageTab);
        nextTab.focus();
      }
    });
  });
</script>
