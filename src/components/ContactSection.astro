---
import { siteConfig } from '../data/siteConfig';
---

<section id="contacto" class="scroll-mt-20 sm:scroll-mt-24 py-24 sm:py-32 relative bg-[#FAFBF7] border-t border-[#D9DED4]" aria-labelledby="contact-heading">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <div class="max-w-4xl mx-auto text-center space-y-10">
      
      <!-- Headline -->
      <h2
        id="contact-heading"
        class="text-5xl sm:text-7xl md:text-8xl font-extrabold text-[#182019] tracking-tight leading-[1.04]"
      >
        ¿Qué necesitás resolver?<br />
        <span class="font-serif italic font-normal text-[#263B2B]">
          Hablemos<span class="text-[#6F8F72] not-italic">.</span>
        </span>
      </h2>

      <!-- Subtitle -->
      <p class="text-lg sm:text-2xl text-[#697069] max-w-2xl mx-auto font-normal leading-relaxed">
        Escribime por WhatsApp y contame qué tenés y qué te gustaría. Si todavía no sabés bien qué necesitás, también está bien: lo vemos juntos.
      </p>

      <!-- Dominant Primary Action (WhatsApp) -->
      <div class="pt-4 flex flex-col items-center gap-4">
        <a
          href={siteConfig.contact.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contame qué necesitás por WhatsApp (abre en una nueva pestaña)"
          class="group inline-flex min-h-11 items-center gap-4 px-9 py-5 rounded-full bg-[#263B2B] text-[#F4F5ED] text-lg font-bold tracking-wide hover:bg-[#182019] shadow-md hover:shadow-xl transition-[background-color,box-shadow,transform] hover:scale-[1.02] motion-reduce:hover:scale-100"
        >
          <span class="relative flex h-3 w-3" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#A8BFA3] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-[#6F8F72]"></span>
          </span>
          <span>Contame qué necesitás</span>
          <span class="text-[#A8BFA3] text-xl group-hover:translate-x-1 group-hover:-translate-y-0.5 transition-transform motion-reduce:group-hover:translate-x-0 motion-reduce:group-hover:translate-y-0" aria-hidden="true">↗</span>
        </a>
        <p class="text-xs font-mono text-[#697069]">
          Me escribís directo a mí, sin formularios.
        </p>
      </div>

      <!-- Discreet Secondary Channels (Email, Instagram, GitHub) -->
      <div class="pt-12 border-t border-[#D9DED4]/60 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-[#697069]">
        <span>
          O por correo: <a href={`mailto:${siteConfig.contact.email}`} class="inline-flex min-h-11 items-center font-medium text-[#182019] hover:text-primary-text underline ml-1">{siteConfig.contact.email}</a>
        </span>
        <span class="hidden sm:inline text-[#D9DED4]" aria-hidden="true">/</span>
        <a
          href={siteConfig.contact.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de flitzfa (abre en una nueva pestaña)"
          class="inline-flex min-h-11 items-center px-1 -mx-1 hover:text-[#182019] underline font-medium"
        >
          Instagram ↗
        </a>
        <span class="hidden sm:inline text-[#D9DED4]" aria-hidden="true">/</span>
        <a
          href={siteConfig.contact.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub de flitzfa (abre en una nueva pestaña)"
          class="inline-flex min-h-11 items-center px-1 -mx-1 hover:text-[#182019] underline font-medium"
        >
          GitHub ↗
        </a>
      </div>

    </div>

  </div>
</section>
