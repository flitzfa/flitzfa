---
import { siteConfig } from '../data/siteConfig';
---

<header
  class="sticky top-0 z-40 w-full transition-all duration-300 backdrop-blur-md bg-[#F4F5ED]/85 border-b border-[#D9DED4]/60"
  id="main-nav"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 h-20 flex items-center justify-between">
    <!-- Brand Wordmark -->
    <a
      href="#inicio"
      class="group inline-flex items-baseline text-2xl sm:text-[26px] font-bold tracking-tight text-[#182019] hover:opacity-90"
      aria-label="flitzfa. - Inicio"
    >
      <span>flitzfa</span>
      <span class="inline-block w-2 h-2 rounded-full bg-[#6F8F72] ml-0.5 transition-transform duration-300 group-hover:scale-125"></span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      {siteConfig.nav.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-[#697069] hover:text-[#182019] transition-colors relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-[#6F8F72] hover:after:w-full after:transition-all after:duration-200"
        >
          {item.label}
        </a>
      ))}

      <!-- Direct Contact CTA -->
      <a
        href="#contacto"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#FAFBF7] border border-[#D9DED4] text-xs font-semibold tracking-wide uppercase text-[#182019] hover:border-[#6F8F72] hover:bg-[#DCE7D7]/40 shadow-xs"
      >
        <span>Hablemos</span>
        <span class="text-[#6F8F72]">↗</span>
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 rounded-full bg-[#FAFBF7] border border-[#D9DED4] text-[#182019] focus:outline-none focus:ring-2 focus:ring-[#6F8F72]"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
    >
      <span class="w-4 h-[1.5px] bg-[#182019] transition-all duration-300 mb-1" id="bar1"></span>
      <span class="w-4 h-[1.5px] bg-[#182019] transition-all duration-300" id="bar2"></span>
    </button>
  </div>

  <!-- Mobile Dropdown / Drawer -->
  <div
    id="mobile-nav-panel"
    class="hidden md:hidden border-b border-[#D9DED4] bg-[#FAFBF7]/95 backdrop-blur-lg px-6 py-8 transition-all"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-6" aria-label="Menú móvil">
      {siteConfig.nav.map((item, index) => (
        <a
          href={item.href}
          class="mobile-nav-link text-xl font-medium text-[#182019] hover:text-[#6F8F72] flex items-center justify-between border-b border-[#D9DED4]/40 pb-3"
        >
          <span>{item.label}</span>
          <span class="text-xs font-mono text-[#697069]">0{index + 1}</span>
        </a>
      ))}
      <a
        href="#contacto"
        class="mobile-nav-link mt-2 inline-flex justify-center items-center gap-2 py-3 rounded-xl bg-[#263B2B] text-[#F4F5ED] text-sm font-semibold hover:bg-[#182019]"
      >
        <span>Iniciar un proyecto</span>
        <span class="text-[#A8BFA3]">↗</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-nav-panel');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const links = document.querySelectorAll('.mobile-nav-link');

  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    if (btn && panel && bar1 && bar2) {
      btn.setAttribute('aria-expanded', String(isOpen));
      panel.setAttribute('aria-hidden', String(!isOpen));
      if (isOpen) {
        panel.classList.remove('hidden');
        bar1.style.transform = 'translateY(2.5px) rotate(45deg)';
        bar2.style.transform = 'translateY(-2.5px) rotate(-45deg)';
      } else {
        panel.classList.add('hidden');
        bar1.style.transform = 'none';
        bar2.style.transform = 'none';
      }
    }
  }

  btn?.addEventListener('click', toggleMenu);

  // Close menu when clicking any nav link
  links.forEach((l) => {
    l.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  });
</script>
