---
import { siteConfig, type NavItem } from '../data/siteConfig';

interface Props {
  items?: NavItem[];
  overlayHero?: boolean;
}

const { items = siteConfig.nav, overlayHero = false } = Astro.props;
const homeHref = Astro.url.pathname === '/' ? '#inicio' : '/';
---

<header
  class:list={[
    'z-40 w-full transition-[background-color,border-color,color,box-shadow] duration-200',
    overlayHero
      ? 'fixed top-0 left-0 right-0 bg-transparent border-b border-transparent text-[#F5F6F0]'
      : 'sticky top-0 bg-[#F5F6F0]/90 backdrop-blur-md border-b border-[#D8DFD5]/80 text-[#141D16]',
  ]}
  data-overlay={overlayHero ? 'true' : 'false'}
  data-scrolled="false"
  id="main-nav"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 h-20 flex items-center justify-between">
    <!-- Brand Wordmark (stronger presence than menu links) -->
    <a
      href={homeHref}
      class="group inline-flex min-h-11 items-center text-[26px] font-bold tracking-[-0.03em] text-current hover:opacity-90"
      aria-label="flitzfa. - Inicio"
    >
      <span>flitzfa</span>
      <span
        class="nav-dot inline-block w-2 h-2 rounded-full bg-[#8CC096] ml-0.5 transition-transform duration-200 group-hover:scale-125"
        aria-hidden="true"
      ></span>
    </a>

    <!-- Desktop Navigation Links (single compact line, sentence case) -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      {items.map((item) => (
        <a
          href={item.href}
          class="nav-link inline-flex min-h-11 items-center type-sm font-medium opacity-80 hover:opacity-100"
        >
          {item.label}
        </a>
      ))}

      <a
        href="#contacto"
        class="nav-cta inline-flex min-h-11 items-center gap-2 px-5 py-2.5 rounded-full type-sm font-semibold"
      >
        <span>Hablemos</span>
        <span aria-hidden="true">↓</span>
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="nav-mobile-btn md:hidden flex flex-col justify-center items-center w-11 h-11 rounded-full border border-current/25"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
    >
      <span class="w-4 h-[1.5px] bg-current transition-transform duration-200 mb-1" id="bar1" aria-hidden="true"></span>
      <span class="w-4 h-[1.5px] bg-current transition-transform duration-200" id="bar2" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile Dropdown / Drawer -->
  <div
    id="mobile-nav-panel"
    class="hidden md:hidden max-h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain border-b border-[#D8DFD5] bg-[#FCFDF9] text-[#141D16] px-6 py-6 shadow-lg"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-2" aria-label="Menú móvil">
      {items.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link min-h-11 py-2.5 type-body font-medium text-[#141D16] hover:text-[#375B3F] flex items-center border-b border-[#D8DFD5]/60"
        >
          {item.label}
        </a>
      ))}
      <a
        href="#contacto"
        class="mobile-nav-link mt-4 min-h-11 inline-flex justify-center items-center gap-2 px-5 py-3 rounded-full bg-[#1A2E20] text-[#F5F6F0] type-sm font-semibold hover:bg-[#141D16]"
      >
        <span>Contame qué necesitás</span>
        <span class="text-[#9BB89E]" aria-hidden="true">↓</span>
      </a>
    </nav>
  </div>
</header>

<style>
  #main-nav[data-overlay='true'][data-scrolled='false'] .nav-cta {
    background-color: rgba(245, 246, 240, 0.14);
    border: 1px solid rgba(245, 246, 240, 0.28);
    color: #F5F6F0;
  }
  #main-nav[data-overlay='true'][data-scrolled='false'] .nav-cta:hover {
    background-color: rgba(245, 246, 240, 0.24);
    border-color: rgba(245, 246, 240, 0.5);
  }

  #main-nav[data-overlay='false'] .nav-cta,
  #main-nav[data-overlay='true'][data-scrolled='true'] .nav-cta {
    background-color: #1A2E20;
    border: 1px solid #1A2E20;
    color: #F5F6F0;
  }
  #main-nav[data-overlay='false'] .nav-cta:hover,
  #main-nav[data-overlay='true'][data-scrolled='true'] .nav-cta:hover {
    background-color: #141D16;
  }

  #main-nav[data-overlay='true'][data-scrolled='true'] {
    background-color: rgba(245, 246, 240, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: rgba(216, 223, 213, 0.9);
    color: #141D16;
  }

  #main-nav[data-overlay='false'] .nav-dot,
  #main-nav[data-overlay='true'][data-scrolled='true'] .nav-dot {
    background-color: #4F7A59;
  }
</style>

<script>
  const header = document.getElementById('main-nav');
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-nav-panel');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const links = panel?.querySelectorAll<HTMLElement>('.mobile-nav-link') ?? [];
  const firstLink = panel?.querySelector<HTMLElement>('.mobile-nav-link');
  const mobileBreakpoint = window.matchMedia('(min-width: 768px)');

  let isOpen = false;

  function syncScrolledState() {
    if (!header || header.dataset.overlay !== 'true') return;
    const scrolled = window.scrollY > 40 || isOpen;
    header.dataset.scrolled = scrolled ? 'true' : 'false';
  }

  function setMenuState(nextOpen: boolean, restoreFocus = false) {
    isOpen = nextOpen;
    if (btn && panel && bar1 && bar2) {
      btn.setAttribute('aria-expanded', String(isOpen));
      btn.setAttribute('aria-label', isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      panel.setAttribute('aria-hidden', String(!isOpen));
      if (isOpen) {
        panel.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        bar1.style.transform = 'translateY(2.5px) rotate(45deg)';
        bar2.style.transform = 'translateY(-2.5px) rotate(-45deg)';
        requestAnimationFrame(() => firstLink?.focus());
      } else {
        panel.classList.add('hidden');
        document.body.style.overflow = '';
        bar1.style.transform = 'none';
        bar2.style.transform = 'none';
        if (restoreFocus) requestAnimationFrame(() => btn.focus({ preventScroll: true }));
      }
      syncScrolledState();
    }
  }

  window.addEventListener('scroll', syncScrolledState, { passive: true });
  syncScrolledState();

  btn?.addEventListener('click', () => setMenuState(!isOpen, isOpen));
  links.forEach((link) => link.addEventListener('click', () => setMenuState(false, true)));

  document.addEventListener('keydown', (event) => {
    if (!isOpen) return;

    if (event.key === 'Escape') {
      setMenuState(false, true);
      return;
    }

    if (event.key === 'Tab' && btn && links.length > 0) {
      const lastLink = links[links.length - 1];
      if (event.shiftKey && document.activeElement === btn) {
        event.preventDefault();
        lastLink.focus();
      } else if (!event.shiftKey && document.activeElement === lastLink) {
        event.preventDefault();
        btn.focus();
      }
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (isOpen && event.target instanceof Node && !header?.contains(event.target)) {
      setMenuState(false, true);
    }
  });

  mobileBreakpoint.addEventListener('change', (event) => {
    if (event.matches && isOpen) setMenuState(false);
  });
</script>
