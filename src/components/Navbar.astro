---
import { siteConfig } from '../data/siteConfig';
---

<header
  class="sticky top-0 z-40 w-full transition-colors duration-300 backdrop-blur-md bg-[#F4F5ED]/85 border-b border-[#D9DED4]/60"
  id="main-nav"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 h-20 flex items-center justify-between">
    <!-- Brand Wordmark -->
    <a
      href="#inicio"
      class="group inline-flex min-h-11 items-center text-2xl sm:text-[26px] font-bold tracking-tight text-[#182019] hover:opacity-90"
      aria-label="flitzfa. - Inicio"
    >
      <span>flitzfa</span>
      <span class="inline-block w-2 h-2 rounded-full bg-[#6F8F72] ml-0.5 transition-transform duration-300 group-hover:scale-125" aria-hidden="true"></span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      {siteConfig.nav.map((item) => (
        <a
          href={item.href}
          class="inline-flex min-h-11 items-center text-sm font-medium text-[#697069] hover:text-[#182019] transition-colors relative after:content-[''] after:absolute after:bottom-1 after:left-0 after:w-0 after:h-[1.5px] after:bg-[#6F8F72] hover:after:w-full after:transition-[width] after:duration-200"
        >
          {item.label}
        </a>
      ))}

      <!-- Direct Contact CTA -->
      <a
        href="#contacto"
        class="inline-flex min-h-11 items-center gap-1.5 px-4 py-2 rounded-full bg-[#FAFBF7] border border-[#D9DED4] text-xs font-semibold tracking-wide uppercase text-[#182019] hover:border-[#6F8F72] hover:bg-[#DCE7D7]/40 shadow-xs"
      >
        <span>Hablemos</span>
        <span class="text-[#6F8F72]" aria-hidden="true">↓</span>
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden flex flex-col justify-center items-center w-11 h-11 rounded-full bg-[#FAFBF7] border border-[#D9DED4] text-[#182019] hover:border-[#6F8F72]"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
    >
      <span class="w-4 h-[1.5px] bg-[#182019] transition-transform duration-300 mb-1" id="bar1" aria-hidden="true"></span>
      <span class="w-4 h-[1.5px] bg-[#182019] transition-transform duration-300" id="bar2" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile Dropdown / Drawer -->
  <div
    id="mobile-nav-panel"
    class="hidden md:hidden max-h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain border-b border-[#D9DED4] bg-[#FAFBF7]/95 backdrop-blur-lg px-6 py-6"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-3" aria-label="Menú móvil">
      {siteConfig.nav.map((item, index) => (
        <a
          href={item.href}
          class="mobile-nav-link min-h-11 py-2 text-xl font-medium text-[#182019] hover:text-primary-text flex items-center justify-between border-b border-[#D9DED4]/40"
        >
          <span>{item.label}</span>
          <span class="text-xs font-mono text-[#697069]">0{index + 1}</span>
        </a>
      ))}
      <a
        href="#contacto"
        class="mobile-nav-link mt-2 min-h-11 inline-flex justify-center items-center gap-2 px-4 py-3 rounded-xl bg-[#263B2B] text-[#F4F5ED] text-sm font-semibold hover:bg-[#182019]"
      >
        <span>Iniciar un proyecto</span>
        <span class="text-[#A8BFA3]" aria-hidden="true">↓</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-nav-panel');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const links = panel?.querySelectorAll<HTMLElement>('.mobile-nav-link') ?? [];
  const firstLink = panel?.querySelector<HTMLElement>('.mobile-nav-link');
  const mobileBreakpoint = window.matchMedia('(min-width: 768px)');

  let isOpen = false;

  function setMenuState(nextOpen: boolean, restoreFocus = false) {
    isOpen = nextOpen;
    if (btn && panel && bar1 && bar2) {
      btn.setAttribute('aria-expanded', String(isOpen));
      btn.setAttribute('aria-label', isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      panel.setAttribute('aria-hidden', String(!isOpen));
      if (isOpen) {
        panel.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        bar1.style.transform = 'translateY(2.5px) rotate(45deg)';
        bar2.style.transform = 'translateY(-2.5px) rotate(-45deg)';
        requestAnimationFrame(() => firstLink?.focus());
      } else {
        panel.classList.add('hidden');
        document.body.style.overflow = '';
        bar1.style.transform = 'none';
        bar2.style.transform = 'none';
        if (restoreFocus) requestAnimationFrame(() => btn.focus({ preventScroll: true }));
      }
    }
  }

  btn?.addEventListener('click', () => setMenuState(!isOpen, isOpen));

  links.forEach((link) => link.addEventListener('click', () => setMenuState(false, true)));

  document.addEventListener('keydown', (event) => {
    if (!isOpen) return;

    if (event.key === 'Escape') {
      setMenuState(false, true);
      return;
    }

    if (event.key === 'Tab' && btn && links.length > 0) {
      const lastLink = links[links.length - 1];

      if (event.shiftKey && document.activeElement === btn) {
        event.preventDefault();
        lastLink.focus();
      } else if (!event.shiftKey && document.activeElement === lastLink) {
        event.preventDefault();
        btn.focus();
      }
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (isOpen && event.target instanceof Node && !document.getElementById('main-nav')?.contains(event.target)) {
      setMenuState(false, true);
    }
  });

  mobileBreakpoint.addEventListener('change', (event) => {
    if (event.matches && isOpen) setMenuState(false);
  });
</script>
