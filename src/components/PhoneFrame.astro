---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
}

const { src, alt, sizes, class: className } = Astro.props;
---

<div class:list={['rounded-[2rem] bg-[#182019] p-[7px] shadow-xl ring-1 ring-black/10', className]}>
  <Image
    src={src}
    alt={alt}
    widths={[240, 390, 560]}
    sizes={sizes}
    class="block w-full h-auto rounded-[1.6rem]"
    loading="lazy"
    decoding="async"
  />
</div>
