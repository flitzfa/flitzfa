---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ProjectItem } from '../data/projects';
import mariaBeachLogo from '../assets/projects/mariabeach-logo.png';
import band620Photo from '../assets/projects/620-band.jpg';
import mariaBeachScreen from '../assets/screens/maria-beach.webp';
import band620Screen from '../assets/screens/620-trio.webp';
import walterScreen from '../assets/screens/walter-zelaya.webp';
import juanScreen from '../assets/screens/juan-enriquez.webp';
import PhoneFrame from './PhoneFrame.astro';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const isReversed = project.layoutReversed;

// Mobile capture of the live site, plus a real photo or logo from the client when there is one.
const showcases: Record<string, { screen: ImageMetadata; screenAlt: string; photo?: { src: ImageMetadata; alt: string }; logo?: boolean }> = {
  'maria-beach': {
    screen: mariaBeachScreen,
    screenAlt: 'Portada de la web de María Beach en un celular: el lema “El río tiene su lugar.” sobre una foto del atardecer en el río, con los botones “Conocé María” y “Hacé tu consulta”.',
    photo: { src: mariaBeachLogo, alt: 'Logo de María Beach' },
    logo: true,
  },
  '620-trio': {
    screen: band620Screen,
    screenAlt: 'Portada de la web de 620 Trío en un celular: el nombre del trío sobre un fondo verde con una ruta dibujada y botones para escribir por WhatsApp o escuchar.',
    photo: { src: band620Photo, alt: 'Integrantes de 620 Trío en Estudios ION' },
  },
  'walter-zelaya': {
    screen: walterScreen,
    screenAlt: 'Portada de la web de Walter Zelaya en un celular: su nombre en letras grandes sobre fondo oscuro con cuerdas de guitarra, el texto “Guitarrista · Compositor · Arreglador” y botones para ver proyectos y escuchar.',
  },
  'juan-enriquez': {
    screen: juanScreen,
    screenAlt: 'Portada de la web de Juan Enriquez en un celular: su nombre, “Profesor de Educación Musical, Compositor, Showman”, una cita sobre la guitarra y la composición, y botones para explorar su obra y contactarlo.',
  },
};
const showcase = showcases[project.id];
---

<article
  class="project-item py-14 sm:py-20 lg:py-28 border-b border-[#D9DED4]/60 last:border-b-0"
  id={project.id}
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">

    <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center ${isReversed ? 'lg:grid-flow-dense' : ''}`}>
      
      <!-- Text / Editorial Content Column -->
      <div class={`lg:col-span-5 flex flex-col justify-center ${isReversed ? 'lg:col-start-8' : 'lg:col-start-1'}`}>
        
        <p class="mb-4 sm:mb-5 font-mono text-xs text-[#697069] tracking-wider uppercase">
          {project.rubro}
        </p>

        <!-- Client Name -->
        <h3 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[#182019] tracking-tight leading-[1.06]">
          {project.client}
        </h3>

        {project.tagline && (
          <p class="mt-3 text-xl sm:text-2xl font-serif italic text-[#263B2B]">
            {project.tagline}
          </p>
        )}

        {project.location && (
          <p class="mt-2 text-xs font-mono text-[#697069]">
            {project.location}
          </p>
        )}

        <div class="mt-5 sm:mt-6 border-t border-[#D9DED4]/80 pt-5">
          <p class="text-[#4A524B] text-base leading-relaxed">{project.story}</p>
          {project.quote && (
            <blockquote class="mt-4 pl-4 border-l-2 border-[#6F8F72] font-serif italic text-lg text-[#263B2B]">
              “{project.quote}”
            </blockquote>
          )}
          <p class="mt-4 text-xs font-mono text-[#697069]">{project.technologies.join(' · ')}</p>
        </div>

        <!-- Action Link -->
        {project.liveUrl && <div class="mt-6 pt-1">
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver ${project.client} en vivo (abre en una nueva pestaña)`}
            class="group/link inline-flex min-h-11 items-center gap-3 text-base font-semibold text-[#182019] hover:text-[#263B2B] transition-colors"
          >
            <span class="border-b-2 border-[#6F8F72] pb-0.5 group-hover/link:border-[#263B2B] transition-colors">
              Ver proyecto en vivo
            </span>
            <span
              class="w-9 h-9 rounded-full flex items-center justify-center border border-[#D9DED4] bg-[#FAFBF7] group-hover/link:border-[#6F8F72] group-hover/link:bg-[#DCE7D7]/60 group-hover/link:translate-x-1 group-hover/link:-translate-y-1 transition-[background-color,border-color,transform] motion-reduce:group-hover/link:translate-x-0 motion-reduce:group-hover/link:translate-y-0"
              aria-hidden="true"
            >
              <span class="text-xs font-bold text-[#182019]">↗</span>
            </span>
          </a>
        </div>}
      </div>

      <!-- High-Scale Editorial Showcase Column -->
      <div class={`lg:col-span-7 ${isReversed ? 'lg:col-start-1' : 'lg:col-start-6'}`}>
        <div
          class="group/showcase relative overflow-hidden rounded-3xl sm:rounded-[32px] transition-shadow duration-700 hover:shadow-2xl"
          style={`background-color: ${project.palette.bgPreview};`}
        >

          {showcase && (
            <div class="relative min-h-[460px] sm:min-h-[540px] lg:min-h-[580px] p-8 sm:p-12 flex items-center justify-center">
              {showcase.photo && (<div
                class:list={[
                  'hidden sm:flex shrink-0 -mr-8 -rotate-3 overflow-hidden rounded-2xl border border-black/10 shadow-lg',
                  showcase.logo ? 'w-48 h-48 items-center justify-center p-6 bg-white/85' : 'w-52 h-72 lg:w-56 lg:h-80',
                ]}
              >
                {showcase.logo ? (
                  <Image
                    src={showcase.photo.src}
                    alt={showcase.photo.alt}
                    format="png"
                    width={360}
                    height={360}
                    widths={[160, 240, 360]}
                    sizes="144px"
                    class="max-h-full max-w-full object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Picture
                    src={showcase.photo.src}
                    alt={showcase.photo.alt}
                    formats={['webp']}
                    width={480}
                    widths={[320, 480]}
                    sizes="224px"
                    quality={82}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                    pictureAttributes={{ class: 'contents' }}
                  />
                )}
              </div>)}
              <PhoneFrame
                src={showcase.screen}
                alt={showcase.screenAlt}
                sizes="(min-width: 640px) 240px, 210px"
                class="relative z-10 w-[210px] sm:w-[240px] shrink-0"
              />
            </div>
          )}

          <!-- Automatic prospecting: own project, no live site, so it keeps its flow diagram -->
          {project.id === 'prospeccion-automatica' && (
            <div class="relative min-h-[520px] sm:min-h-[560px] lg:min-h-[580px] p-6 sm:p-10 lg:p-12 flex flex-col justify-between overflow-hidden bg-gradient-to-br from-[#EEF2E9] via-[#E4EADF] to-[#D7E2D3]">
              <div
                class="absolute -top-24 -right-16 w-80 h-80 rounded-full bg-[#6F8F72]/15 blur-3xl pointer-events-none"
                aria-hidden="true"
              ></div>

              <div class="relative z-10 flex flex-wrap items-center justify-between gap-3">
                <span class="text-[11px] font-mono text-[#4D5F50] uppercase">
                  Flujo sin datos privados
                </span>
              </div>

              <div class="relative z-10 py-8 sm:py-10">
                <p class="text-xs font-mono uppercase tracking-widest text-[#5A775D] font-semibold mb-3">
                  De datos sueltos a una lista para contactar
                </p>
                <h4 class="max-w-xl text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#182019] tracking-tight leading-[1.08]">
                  Busca negocios, los investiga y los anota en una planilla para que yo elija a quién escribirle.
                </h4>

                <ol class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border-y border-[#6F8F72]/35" aria-label="Flujo del sistema automático de prospección">
                  {[
                    ['01', 'Prospectos', 'Busca negocios que podrían necesitar una web'],
                    ['02', 'Investigación', 'Junta lo que hay de cada uno: rubro, redes, si tiene web'],
                    ['03', 'IA', 'Resume lo importante de cada negocio'],
                    ['04', 'Clasificación', 'Los ordena según qué tan buen candidato es'],
                    ['05', 'Google Sheets', 'Todo queda anotado en una planilla'],
                    ['06', 'Preparación', 'Yo reviso la lista y elijo a quién escribirle'],
                  ].map(([number, title, description]) => (
                    <li class="py-4 sm:py-5 border-b last:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 border-[#6F8F72]/25 sm:pr-4">
                      <div class="flex items-baseline gap-3">
                        <span class="text-[10px] font-mono text-[#5A775D] font-bold" aria-hidden="true">{number}</span>
                        <div>
                          <p class="text-sm font-bold text-[#182019]">{title}</p>
                          <p class="mt-1 text-xs text-[#5C685E] leading-relaxed">{description}</p>
                        </div>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          )}

        </div>
      </div>

    </div>

  </div>
</article>
