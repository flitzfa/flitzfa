---
import type { ProjectItem } from '../data/projects';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const isReversed = project.layoutReversed;
---

<article
  class="project-item py-16 md:py-24 lg:py-32 border-b border-[#D9DED4]/60 last:border-b-0 transition-colors duration-500"
  id={project.id}
  data-interactive
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center ${isReversed ? 'lg:grid-flow-dense' : ''}`}>
      
      <!-- Text / Editorial Content Column -->
      <div class={`lg:col-span-5 flex flex-col justify-center ${isReversed ? 'lg:col-start-8' : 'lg:col-start-1'}`}>
        
        <!-- Project Number & Category Badge -->
        <div class="flex items-center gap-3 mb-4">
          <span class="font-mono text-xs tracking-widest text-[#697069] uppercase font-medium">
            {project.number} —
          </span>
          <span
            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium tracking-wide"
            style={`background-color: ${project.palette.badgeBg}; color: ${project.palette.badgeText};`}
          >
            {project.category}
          </span>
        </div>

        <!-- Client Name -->
        <h3 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-[#182019] tracking-tight leading-[1.12]">
          {project.client}
        </h3>

        <!-- Client Tagline -->
        <p class="mt-2 text-lg sm:text-xl font-serif italic text-[#263B2B]">
          {project.tagline}
        </p>

        <!-- Location -->
        <div class="mt-1 text-xs font-mono text-[#697069] flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#6F8F72]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{project.location}</span>
        </div>

        <!-- Summary -->
        <p class="mt-6 text-[#697069] text-base sm:text-lg leading-relaxed font-normal">
          {project.summary}
        </p>

        <!-- Deliverables Tags -->
        <div class="mt-6 flex flex-wrap gap-2">
          {project.deliverables.map((tag) => (
            <span class="inline-block px-3 py-1 text-xs font-mono rounded-md bg-[#FAFBF7] border border-[#D9DED4] text-[#182019]">
              {tag}
            </span>
          ))}
        </div>

        <!-- Action Link -->
        <div class="mt-8 pt-4">
          <a
            href={project.liveUrl || '#'}
            target="_blank"
            rel="noopener noreferrer"
            class="group/link inline-flex items-center gap-2.5 text-sm font-semibold text-[#182019] transition-all hover:text-[#263B2B]"
          >
            <span class="relative pb-0.5 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[1.5px] after:bg-[#6F8F72] after:origin-bottom-left group-hover/link:after:scale-x-110 after:transition-transform">
              Ver sitio web del cliente
            </span>
            <span
              class="w-8 h-8 rounded-full flex items-center justify-center border border-[#D9DED4] bg-[#FAFBF7] group-hover/link:border-[#6F8F72] group-hover/link:bg-[#DCE7D7]/50 group-hover/link:translate-x-1 group-hover/link:-translate-y-1 transition-all"
            >
              <span class="text-xs font-bold text-[#182019]">↗</span>
            </span>
          </a>
        </div>
      </div>

      <!-- Visual Preview Showcase Column -->
      <div class={`lg:col-span-7 ${isReversed ? 'lg:col-start-1' : 'lg:col-start-6'}`}>
        <div
          class="group/preview relative overflow-hidden rounded-2xl sm:rounded-3xl border border-[#D9DED4] shadow-sm transition-all duration-500 hover:shadow-xl hover:border-[#6F8F72]/50"
          style={`background-color: ${project.palette.bgPreview};`}
        >
          <!-- Mockup Window Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-black/5 bg-white/40 backdrop-blur-xs">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-[#182019]/20"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#182019]/20"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#182019]/20"></span>
            </div>
            <span class="text-[11px] font-mono text-[#697069]/80 truncate max-w-[200px]">
              {project.client.toLowerCase().replace(/\s+/g, '')}.com.ar
            </span>
            <span class="text-[10px] font-mono uppercase tracking-wider text-[#697069]">flitzfa · web</span>
          </div>

          <!-- Project Custom Rich Visual Presentation -->
          <div class="p-4 sm:p-6 md:p-8 overflow-hidden">
            {project.id === 'maria-beach' && (
              <div class="relative bg-gradient-to-b from-[#EBF6FB] to-[#F5FAFC] rounded-xl p-6 sm:p-8 border border-[#77C8E9]/30 transition-transform duration-750 group-hover/preview:scale-[1.015]">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
                  <div class="space-y-4 max-w-sm text-left">
                    <span class="text-[11px] font-mono tracking-widest text-[#2A7B9B] uppercase font-semibold">
                      Rincón Santa María · Ituzaingó
                    </span>
                    <h4 class="text-3xl sm:text-4xl font-extrabold text-[#12303D] leading-tight font-sans">
                      El río tiene<br /><span class="italic font-serif font-normal text-[#2A7B9B]">su lugar.</span>
                    </h4>
                    <p class="text-xs sm:text-sm text-[#3E5C6A] leading-relaxed">
                      Playa, cantina, música y encuentros que se quedan un rato más a orillas del Paraná.
                    </p>
                    <div class="flex gap-2 pt-2">
                      <span class="px-2.5 py-1 rounded-full bg-[#77C8E9]/20 text-[#12303D] text-[11px] font-medium font-mono">DÍA</span>
                      <span class="px-2.5 py-1 rounded-full bg-[#F5A623]/20 text-[#12303D] text-[11px] font-medium font-mono">SUNSET</span>
                      <span class="px-2.5 py-1 rounded-full bg-[#2A7B9B]/20 text-[#12303D] text-[11px] font-medium font-mono">NOCHE</span>
                    </div>
                  </div>
                  <div class="relative w-40 h-40 sm:w-48 sm:h-48 flex items-center justify-center p-4 rounded-2xl bg-white/70 shadow-inner border border-[#77C8E9]/40">
                    <img
                      src="/assets/projects/mariabeach-logo.png"
                      alt="Logo oficial de María Beach"
                      class="max-h-full max-w-full object-contain filter drop-shadow-sm transition-transform duration-500 group-hover/preview:rotate-2 group-hover/preview:scale-105"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>
            )}

            {project.id === '620-trio' && (
              <div class="relative bg-[#101114] rounded-xl overflow-hidden border border-white/10 transition-transform duration-750 group-hover/preview:scale-[1.015]">
                <div class="relative h-64 sm:h-80 md:h-96 w-full">
                  <img
                    src="/assets/projects/620-band.jpg"
                    alt="620 Trío en vivo y ensayo"
                    class="w-full h-full object-cover opacity-80 filter grayscale hover:grayscale-0 transition-all duration-700 group-hover/preview:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#101114] via-[#101114]/40 to-transparent"></div>
                  
                  <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 text-left">
                    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#E6A15C]/20 text-[#E6A15C] text-xs font-mono mb-2">
                      <span>● SHOW CONFIRMADO</span>
                      <span>·</span>
                      <span>Tanque Cultural</span>
                    </div>
                    <h4 class="text-2xl sm:text-3xl font-extrabold text-[#F2EFE9] tracking-tight">
                      Una ruta hecha de canciones.
                    </h4>
                    <p class="text-xs sm:text-sm text-[#B3B0A8] mt-1">
                      Fusión · Folclore · Jazz · Álbum debut “Transporte Ideal”
                    </p>
                  </div>
                </div>
              </div>
            )}

            {project.id === 'kita-fitness' && (
              <div class="relative bg-[#161719] rounded-xl overflow-hidden border border-[#C7FF24]/20 transition-transform duration-750 group-hover/preview:scale-[1.015]">
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 p-4 sm:p-6 items-center">
                  <div class="sm:col-span-6 space-y-4 text-left">
                    <div class="inline-block px-2.5 py-0.5 rounded-sm bg-[#C7FF24] text-[#121212] font-mono text-xs font-bold uppercase tracking-wider">
                      San Justo · Buenos Aires
                    </div>
                    <h4 class="text-3xl sm:text-4xl font-extrabold text-[#F5F5F5] uppercase tracking-tight font-sans leading-tight">
                      Entrena<br /><span class="text-[#C7FF24]">Sin Límites</span>
                    </h4>
                    <p class="text-xs text-[#A0A0A0] leading-relaxed">
                      CrossFit · Funcional · Musculación · Calistenia. Comunidad y rendimiento diario.
                    </p>
                    <div class="pt-1 flex items-center gap-2 text-[11px] font-mono text-[#D4D4D4]">
                      <span class="w-2 h-2 rounded-full bg-[#C7FF24]"></span>
                      <span>Abierto Lun a Sáb · Mariano Santamaría 3457</span>
                    </div>
                  </div>
                  <div class="sm:col-span-6 space-y-3">
                    <div class="h-36 sm:h-44 rounded-lg overflow-hidden border border-white/10 shadow-md">
                      <img
                        src="/assets/projects/kita-socio.jpg"
                        alt="Atleta entrenando en KITA FITNESS"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover/preview:scale-105"
                        loading="lazy"
                      />
                    </div>
                    <div class="h-24 rounded-lg overflow-hidden border border-white/10 hidden sm:block">
                      <img
                        src="/assets/projects/kita-hero.jpg"
                        alt="Fachada del gimnasio KITA"
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  </div>
                </div>
              </div>
            )}

            {project.id === 'portex-vet' && (
              <div class="relative bg-gradient-to-b from-[#F0F8F8] to-[#E5F2F2] rounded-xl p-6 sm:p-8 border border-[#0E7C7B]/20 transition-transform duration-750 group-hover/preview:scale-[1.015]">
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
                  <div class="sm:col-span-7 space-y-4 text-left">
                    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#0E7C7B]/15 text-[#0E7C7B] text-xs font-mono font-medium">
                      <span>18 Especialidades Médicas</span>
                      <span>·</span>
                      <span>Guardia</span>
                    </div>
                    <h4 class="text-2xl sm:text-3xl font-bold text-[#0D3B3A] leading-snug">
                      Medicina veterinaria de alta complejidad.
                    </h4>
                    <p class="text-xs sm:text-sm text-[#3E6564] leading-relaxed">
                      Atención clínica para caninos, felinos y no tradicionales con equipamiento de diagnóstico propio.
                    </p>
                    <div class="grid grid-cols-2 gap-2 pt-2 text-[11px] font-mono text-[#0E7C7B]">
                      <div class="p-2 rounded bg-white/70 border border-[#0E7C7B]/10">✓ Cardiología</div>
                      <div class="p-2 rounded bg-white/70 border border-[#0E7C7B]/10">✓ Traumatología</div>
                      <div class="p-2 rounded bg-white/70 border border-[#0E7C7B]/10">✓ Dermatología</div>
                      <div class="p-2 rounded bg-white/70 border border-[#0E7C7B]/10">✓ Animales exóticos</div>
                    </div>
                  </div>
                  <div class="sm:col-span-5 flex flex-col gap-3">
                    <div class="h-44 rounded-xl overflow-hidden border border-[#0E7C7B]/20 shadow-xs bg-white">
                      <img
                        src="/assets/projects/vet-paciente-1.png"
                        alt="Paciente canino atendido en clínica"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover/preview:scale-105"
                        loading="lazy"
                      />
                    </div>
                    <div class="flex items-center justify-between px-3 py-1.5 rounded-lg bg-white/80 border border-[#0E7C7B]/15 text-[11px] font-mono text-[#0D3B3A]">
                      <span>Isidro Casanova, Bs As</span>
                      <span class="text-[#0E7C7B] font-semibold">Turnos por WhatsApp</span>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

    </div>
  </div>
</article>
