---
import type { ProjectItem } from '../data/projects';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const isReversed = project.layoutReversed;
---

<article
  class="project-item py-20 sm:py-28 lg:py-36 border-b border-[#D9DED4]/60 last:border-b-0"
  id={project.id}
  data-interactive
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <div class={`grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center ${isReversed ? 'lg:grid-flow-dense' : ''}`}>
      
      <!-- Text / Editorial Content Column -->
      <div class={`lg:col-span-5 flex flex-col justify-center ${isReversed ? 'lg:col-start-8' : 'lg:col-start-1'}`}>
        
        <!-- Number & Rubro -->
        <div class="flex items-center gap-3 mb-5">
          <span class="font-mono text-sm tracking-widest text-[#6F8F72] font-semibold">
            {project.number}
          </span>
          <span class="text-xs text-[#D9DED4]">/</span>
          <span class="font-mono text-xs text-[#697069] tracking-wider uppercase">
            {project.rubro}
          </span>
        </div>

        <!-- Client Name -->
        <h3 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[#182019] tracking-tight leading-[1.06]">
          {project.client}
        </h3>

        <!-- Client Tagline -->
        <p class="mt-3 text-xl sm:text-2xl font-serif italic text-[#263B2B]">
          {project.tagline}
        </p>

        <!-- Location -->
        <p class="mt-2 text-xs font-mono text-[#697069]">
          {project.location}
        </p>

        <!-- Summary -->
        <p class="mt-6 text-[#697069] text-base sm:text-lg leading-relaxed font-normal">
          {project.summary}
        </p>

        <!-- Action Link -->
        <div class="mt-8 pt-2">
          <a
            href={project.liveUrl || '#'}
            target="_blank"
            rel="noopener noreferrer"
            class="group/link inline-flex items-center gap-3 text-base font-semibold text-[#182019] hover:text-[#263B2B] transition-all"
          >
            <span class="border-b-2 border-[#6F8F72] pb-0.5 group-hover/link:border-[#263B2B] transition-colors">
              Ver proyecto en vivo
            </span>
            <span
              class="w-9 h-9 rounded-full flex items-center justify-center border border-[#D9DED4] bg-[#FAFBF7] group-hover/link:border-[#6F8F72] group-hover/link:bg-[#DCE7D7]/60 group-hover/link:translate-x-1 group-hover/link:-translate-y-1 transition-all"
            >
              <span class="text-xs font-bold text-[#182019]">↗</span>
            </span>
          </a>
        </div>
      </div>

      <!-- High-Scale Editorial Showcase Column -->
      <div class={`lg:col-span-7 ${isReversed ? 'lg:col-start-1' : 'lg:col-start-6'}`}>
        <div
          class="group/showcase relative overflow-hidden rounded-3xl sm:rounded-[32px] transition-all duration-700 hover:shadow-2xl"
          style={`background-color: ${project.palette.bgPreview};`}
        >

          <!-- 01 / MARÍA BEACH — High scale river & beach composition -->
          {project.id === 'maria-beach' && (
            <div class="relative min-h-[460px] sm:min-h-[540px] lg:min-h-[580px] p-8 sm:p-12 flex flex-col justify-between overflow-hidden bg-gradient-to-br from-[#E6F3F8] via-[#EDF6F9] to-[#FAF8F2]">
              <!-- Ambient River Wave graphic contour -->
              <div
                class="absolute -right-20 -bottom-20 w-96 h-96 rounded-full bg-[#77C8E9]/15 blur-2xl pointer-events-none"
                aria-hidden="true"
              ></div>

              <!-- Top Bar Info -->
              <div class="flex items-center justify-between gap-2 z-10">
                <span class="text-xs font-mono tracking-widest text-[#2A7B9B] uppercase font-semibold truncate">
                  Rincón Santa María · Ituzaingó
                </span>
                <span class="text-[11px] font-mono text-[#2A7B9B]/70 uppercase shrink-0 hidden sm:inline">
                  mariabeach.com.ar ↗
                </span>
              </div>

              <!-- Center Big Visual Essence -->
              <div class="my-auto py-8 flex flex-col sm:flex-row items-center justify-between gap-8 z-10">
                <div class="max-w-xs space-y-4 text-left">
                  <h4 class="text-4xl sm:text-5xl font-extrabold text-[#12303D] tracking-tight leading-[1.08]">
                    El río tiene<br />
                    <span class="italic font-serif font-normal text-[#2A7B9B]">su lugar.</span>
                  </h4>
                  <p class="text-sm text-[#3E5C6A] leading-relaxed">
                    Playa, cantina, música y encuentros que se quedan un rato más frente al Paraná.
                  </p>
                  <div class="flex gap-2 pt-2 text-xs font-mono font-semibold">
                    <span class="px-3 py-1 rounded-full bg-[#77C8E9]/25 text-[#12303D]">DÍA</span>
                    <span class="px-3 py-1 rounded-full bg-[#F5A623]/25 text-[#12303D]">SUNSET</span>
                    <span class="px-3 py-1 rounded-full bg-[#2A7B9B]/25 text-[#12303D]">NOCHE</span>
                  </div>
                </div>

                <!-- Heroic Brand Logo -->
                <div class="relative w-48 h-48 sm:w-60 sm:h-60 flex items-center justify-center p-6 rounded-3xl bg-white/80 shadow-lg border border-[#77C8E9]/30 transition-transform duration-500 group-hover/showcase:scale-105 group-hover/showcase:rotate-1">
                  <img
                    src="/assets/projects/mariabeach-logo.png"
                    alt="Logo oficial de María Beach"
                    class="max-h-full max-w-full object-contain filter drop-shadow-md"
                    loading="lazy"
                  />
                </div>
              </div>

              <!-- Bottom caption -->
              <div class="flex items-center justify-between pt-4 border-t border-[#2A7B9B]/15 z-10 text-xs font-mono text-[#2A7B9B]">
                <span>Abierto todo el año</span>
                <span>Servicios de playa &amp; cantina</span>
              </div>
            </div>
          )}

          <!-- 02 / 620 TRÍO — Immersive cinematic stage photography -->
          {project.id === '620-trio' && (
            <div class="relative min-h-[460px] sm:min-h-[540px] lg:min-h-[580px] overflow-hidden bg-[#101114]">
              <!-- Band Image spanning full container -->
              <img
                src="/assets/projects/620-band.jpg"
                alt="620 Trío en vivo en Estudios ION"
                class="absolute inset-0 w-full h-full object-cover object-center opacity-85 transition-transform duration-700 ease-out group-hover/showcase:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#101114] via-[#101114]/50 to-[#101114]/20"></div>

              <!-- Content overlay with high contrast -->
              <div class="relative h-full min-h-[460px] sm:min-h-[540px] lg:min-h-[580px] p-8 sm:p-12 flex flex-col justify-between z-10 text-left">
                <div class="flex items-center justify-between gap-2 text-xs font-mono text-white/70">
                  <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E6A15C]/25 text-[#FFC88A] font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#E6A15C] animate-pulse"></span>
                    <span>SHOW EN VIVO</span>
                  </span>
                  <span class="hidden sm:inline">Estudios ION · Buenos Aires</span>
                </div>

                <div class="space-y-3 max-w-md">
                  <h4 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#F2EFE9] tracking-tight leading-tight">
                    Una ruta hecha<br />de canciones.
                  </h4>
                  <p class="text-sm text-[#D4CFC7] font-light">
                    Fusión · Folclore · Jazz contemporáneo · Álbum “Transporte Ideal”
                  </p>
                  <div class="pt-2 text-xs font-mono text-[#FFC88A]">
                    Próxima fecha: Tanque Cultural · Liniers
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- 03 / KITA FITNESS — Raw power, industrial contrast & athletics -->
          {project.id === 'kita-fitness' && (
            <div class="relative min-h-[460px] sm:min-h-[540px] lg:min-h-[580px] p-8 sm:p-12 flex flex-col justify-between overflow-hidden bg-[#121315]">
              <!-- High-voltage accent background glow -->
              <div
                class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-[#C7FF24]/10 blur-3xl pointer-events-none"
                aria-hidden="true"
              ></div>

              <!-- Header Tag -->
              <div class="flex items-center justify-between gap-2 z-10">
                <span class="px-3 py-1 rounded-md bg-[#C7FF24] text-[#121212] font-mono text-xs font-extrabold uppercase tracking-wider">
                  San Justo · Buenos Aires
                </span>
                <span class="text-xs font-mono text-white/50 uppercase hidden sm:inline">
                  kitafitness.com ↗
                </span>
              </div>

              <!-- Central Power Graphic & Photos -->
              <div class="my-auto py-6 grid grid-cols-1 sm:grid-cols-12 gap-6 items-center z-10">
                <div class="sm:col-span-6 space-y-4 text-left">
                  <h4 class="text-4xl sm:text-5xl font-extrabold text-white uppercase tracking-tight leading-[0.95]">
                    Entrena<br />
                    <span class="text-[#C7FF24]">Sin Límites</span>
                  </h4>
                  <p class="text-xs sm:text-sm text-[#A0A0A0] leading-relaxed">
                    CrossFit, Funcional, Musculación y Calistenia. Comunidad y rendimiento diario.
                  </p>
                  <div class="text-xs font-mono text-white/80">
                    Mariano Santamaría 3457
                  </div>
                </div>

                <div class="sm:col-span-6">
                  <div class="h-48 sm:h-64 rounded-2xl overflow-hidden border border-white/15 shadow-2xl transition-transform duration-500 group-hover/showcase:scale-[1.03]">
                    <img
                      src="/assets/projects/kita-socio.jpg"
                      alt="Entrenamiento en KITA FITNESS"
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>

              <!-- Bottom schedule line -->
              <div class="flex items-center justify-between pt-4 border-t border-white/10 z-10 text-xs font-mono text-white/60">
                <span>Lunes a Sábado 07:00 – 22:00</span>
                <span class="text-[#C7FF24] font-semibold">Inscripciones abiertas</span>
              </div>
            </div>
          )}

          <!-- 04 / VETERINARIA PORTEX — Clinical serenity, medical clarity & warmth -->
          {project.id === 'portex-vet' && (
            <div class="relative min-h-[460px] sm:min-h-[540px] lg:min-h-[580px] p-8 sm:p-12 flex flex-col justify-between overflow-hidden bg-gradient-to-br from-[#EEF7F7] via-[#F4FAFA] to-[#E5F3F3]">
              <!-- Header -->
              <div class="flex items-center justify-between gap-2 z-10">
                <span class="px-3 py-1 rounded-full bg-[#0E7C7B]/15 text-[#0E7C7B] text-xs font-mono font-semibold truncate">
                  18 Especialidades Médicas &amp; Guardia
                </span>
                <span class="text-xs font-mono text-[#0E7C7B]/70 shrink-0 hidden sm:inline">
                  Isidro Casanova, Bs As
                </span>
              </div>

              <!-- Center Layout: Patient Close-up & Medical Values -->
              <div class="my-auto py-6 grid grid-cols-1 sm:grid-cols-12 gap-8 items-center z-10">
                <div class="sm:col-span-6 space-y-4 text-left">
                  <h4 class="text-3xl sm:text-4xl font-extrabold text-[#0D3B3A] leading-tight">
                    Medicina veterinaria de alta complejidad.
                  </h4>
                  <p class="text-xs sm:text-sm text-[#3E6564] leading-relaxed">
                    Atención clínica y diagnóstica para caninos, felinos y animales no tradicionales.
                  </p>
                  <div class="space-y-1 text-xs font-mono text-[#0E7C7B] pt-1">
                    <div>✓ Cardiología, Traumatología y Cirugía</div>
                    <div>✓ Animales exóticos y no tradicionales</div>
                  </div>
                </div>

                <div class="sm:col-span-6 flex flex-col items-center sm:items-end">
                  <div class="w-full sm:w-60 h-52 sm:h-64 rounded-2xl overflow-hidden border border-[#0E7C7B]/20 shadow-xl bg-white transition-transform duration-500 group-hover/showcase:scale-[1.03]">
                    <img
                      src="/assets/projects/vet-paciente-1.png"
                      alt="Paciente canino en consulta veterinaria"
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>

              <!-- Bottom Action -->
              <div class="flex items-center justify-between pt-4 border-t border-[#0E7C7B]/15 z-10 text-xs font-mono text-[#0D3B3A]">
                <span>Guardia y urgencias</span>
                <span class="text-[#0E7C7B] font-semibold">Turnos rápidos por WhatsApp ↗</span>
              </div>
            </div>
          )}

        </div>
      </div>

    </div>

  </div>
</article>
