---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ProjectItem } from '../data/projects';
import mariaBeachLogo from '../assets/projects/mariabeach-logo.png';
import band620Photo from '../assets/projects/620-band.jpg';
import mariaBeachScreen from '../assets/screens/maria-beach.webp';
import band620Screen from '../assets/screens/620-trio.webp';
import walterScreen from '../assets/screens/walter-zelaya.webp';
import juanScreen from '../assets/screens/juan-enriquez.webp';
import PhoneFrame from './PhoneFrame.astro';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const isReversed = project.layoutReversed;

const showcases: Record<string, { screen: ImageMetadata; screenAlt: string; photo?: { src: ImageMetadata; alt: string }; logo?: boolean }> = {
  'maria-beach': {
    screen: mariaBeachScreen,
    screenAlt: 'Portada de la web de María Beach en un celular: el lema “El río tiene su lugar.” sobre una foto del atardecer en el río, con los botones “Conocé María” y “Hacé tu consulta”.',
    photo: { src: mariaBeachLogo, alt: 'Logo de María Beach' },
    logo: true,
  },
  '620-trio': {
    screen: band620Screen,
    screenAlt: 'Portada de la web de 620 Trío en un celular: el nombre del trío sobre un fondo verde con una ruta dibujada y botones para escribir por WhatsApp o escuchar.',
    photo: { src: band620Photo, alt: 'Integrantes de 620 Trío en Estudios ION' },
  },
  'walter-zelaya': {
    screen: walterScreen,
    screenAlt: 'Portada de la web de Walter Zelaya en un celular: su nombre en letras grandes sobre fondo oscuro con cuerdas de guitarra, el texto “Guitarrista · Compositor · Arreglador” y botones para ver proyectos y escuchar.',
  },
  'juan-enriquez': {
    screen: juanScreen,
    screenAlt: 'Portada de la web de Juan Enriquez en un celular: su nombre, “Profesor de Educación Musical, Compositor, Showman”, una cita sobre la guitarra y la composición, y botones para explorar su obra y contactarlo.',
  },
};
const showcase = showcases[project.id];
---

<article
  class="project-item py-16 sm:py-22 lg:py-26 border-b border-[#D8DFD5] last:border-b-0"
  id={project.id}
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center ${isReversed ? 'lg:grid-flow-dense' : ''}`}>
      <!-- Editorial Content Column -->
      <div class={`lg:col-span-5 flex flex-col justify-center ${isReversed ? 'lg:col-start-8' : 'lg:col-start-1'}`}>
        <h3 class="type-heading text-[#141D16]">
          {project.client}
        </h3>

        <p class="mt-3 type-sm text-[#375B3F] font-medium">
          {project.rubro}{project.location ? ` · ${project.location}` : ''}
        </p>

        {project.tagline && (
          <p class="mt-4 type-body font-serif italic text-[#1A2E20]">
            {project.tagline}
          </p>
        )}

        <div class="mt-6 border-t border-[#D8DFD5] pt-6">
          <p class="type-body text-[#515B53] max-w-[58ch]">{project.story}</p>

          {project.quote && (
            <blockquote class="mt-5 pl-4 border-l-2 border-[#4F7A59] font-serif italic type-body text-[#1A2E20]">
              “{project.quote}”
            </blockquote>
          )}

          <p class="mt-5 type-sm text-[#515B53]">{project.technologies.join(' · ')}</p>
        </div>

        {project.liveUrl && (
          <div class="mt-7">
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver ${project.client} en vivo (abre en una nueva pestaña)`}
              class="group/link inline-flex min-h-11 items-center gap-3 type-sm font-semibold text-[#141D16] hover:text-[#375B3F]"
            >
              <span class="border-b-2 border-[#4F7A59] pb-0.5 group-hover/link:border-[#1A2E20]">
                Ver proyecto en vivo
              </span>
              <span
                class="w-9 h-9 rounded-full flex items-center justify-center border border-[#D8DFD5] bg-[#FCFDF9] group-hover/link:border-[#4F7A59] group-hover/link:bg-[#DCE8DC]/60 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 motion-reduce:group-hover/link:translate-x-0 motion-reduce:group-hover/link:translate-y-0"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          </div>
        )}
      </div>

      <!-- Visual Showcase Column -->
      <div class={`lg:col-span-7 ${isReversed ? 'lg:col-start-1' : 'lg:col-start-6'}`}>
        <div
          class="relative overflow-hidden rounded-3xl transition-shadow duration-300 hover:shadow-xl"
          style={`background-color: ${project.palette.bgPreview};`}
        >
          {showcase && (
            <div class="relative min-h-[440px] sm:min-h-[520px] lg:min-h-[560px] p-8 sm:p-12 flex items-center justify-center">
              {showcase.photo && (
                <div
                  class:list={[
                    'hidden sm:flex shrink-0 -mr-8 -rotate-2 overflow-hidden rounded-2xl border border-black/10 shadow-lg',
                    showcase.logo ? 'w-44 h-44 items-center justify-center p-6 bg-white/90' : 'w-52 h-72 lg:w-56 lg:h-80',
                  ]}
                >
                  {showcase.logo ? (
                    <Image
                      src={showcase.photo.src}
                      alt={showcase.photo.alt}
                      format="png"
                      width={360}
                      height={360}
                      widths={[160, 240, 360]}
                      sizes="144px"
                      class="max-h-full max-w-full object-contain"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <Picture
                      src={showcase.photo.src}
                      alt={showcase.photo.alt}
                      formats={['webp']}
                      width={480}
                      widths={[320, 480]}
                      sizes="224px"
                      quality={82}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                      pictureAttributes={{ class: 'contents' }}
                    />
                  )}
                </div>
              )}
              <PhoneFrame
                src={showcase.screen}
                alt={showcase.screenAlt}
                sizes="(min-width: 640px) 240px, 210px"
                class="relative z-10 w-[210px] sm:w-[240px] shrink-0"
              />
            </div>
          )}

          {project.id === 'prospeccion-automatica' && (
            <div class="relative min-h-[480px] sm:min-h-[540px] p-6 sm:p-10 lg:p-12 flex flex-col justify-between bg-[#E8EFE6]">
              <div>
                <h4 class="type-heading text-[#141D16] max-w-xl">
                  Busca negocios, los investiga y los anota en una planilla.
                </h4>
                <p class="mt-3 type-sm text-[#375B3F] font-medium">
                  Flujo automatizado sin datos privados
                </p>
              </div>

              <ol class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border-y border-[#4F7A59]/30" aria-label="Flujo del sistema automático de prospección">
                {[
                  ['1', 'Prospectos', 'Busca negocios que podrían necesitar una web'],
                  ['2', 'Investigación', 'Junta rubro, redes y si ya tienen sitio'],
                  ['3', 'Resumen con IA', 'Extrae lo más relevante de cada negocio'],
                  ['4', 'Clasificación', 'Ordena los mejores candidatos primero'],
                  ['5', 'Google Sheets', 'Deja todo registrado en una planilla'],
                  ['6', 'Contacto', 'Yo reviso la lista y elijo a quién escribirle'],
                ].map(([number, title, description]) => (
                  <li class="py-4 sm:py-5 border-b last:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 border-[#4F7A59]/20 sm:pr-4">
                    <div class="flex items-baseline gap-2.5">
                      <span class="type-sm font-semibold text-[#375B3F]" aria-hidden="true">{number}.</span>
                      <div>
                        <p class="type-body font-semibold text-[#141D16]">{title}</p>
                        <p class="mt-1 type-sm text-[#515B53]">{description}</p>
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</article>
